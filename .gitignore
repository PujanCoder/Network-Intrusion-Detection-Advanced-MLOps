# ---------------------------------------------------------------------------
# Project-specific rules
# ---------------------------------------------------------------------------

# Local virtual environments
.venv/
venv/
env/

# Notebook checkpoints
.ipynb_checkpoints/

# Raw and processed CICIDS2017 data (DVC-tracked)
data/raw/*
!data/raw/MachineLearningCSV.dvc
data/interim/
data/processed/

# Downloaded public datasets (UNSW-NB15, NSL-KDD) - fetch, do not vendor
data/external/

# Real-time NDR runtime state
data/realtime/
data/zeek_logs/
*.db
*.db-wal
*.db-shm

# MLflow local store
mlruns/

# Model binaries are large; the live Zeek model is the exception because the
# API loads it at startup.
*.pkl
*.joblib
*.pt
*.pth
!models/zeek/zeek_model.joblib

# Frontend dependencies and build output (built in CI / by scripts/run_api.sh)
frontend/node_modules/
# The React bundle is committed: the hosted build command (Render -> Settings) is
# fixed to `pip install` + artefact checks, so the service serves this directory
# straight from the clone. Rebuild and commit after any frontend change:
#   cd frontend && npm run build   (deterministic; dist must be committed)
# The generic `dist/` rule above is for Python packaging. Re-include the dashboard
# bundle explicitly: git only descends into a re-included directory.
!frontend/dist/
!frontend/dist/**
# Force-track project source folders and tests
!src/serving/
!src/serving/**
!src/features/zeek/
!src/features/zeek/**
!src/ingestion/zeek/
!src/ingestion/zeek/**
!tests/fixtures/
!tests/fixtures/**
!tests/ingestion/
!tests/ingestion/**
# `lib/` above targets Python build output. The dashboard keeps shared
# modules in frontend/src/lib, which must be committed or the build breaks.
!frontend/src/lib/
!frontend/src/lib/**

# Bytecode caches inside the force-tracked source folders
**/__pycache__/

# Local MLflow backend store (recreated by training runs)
mlflow.db
mlflow.db-*
