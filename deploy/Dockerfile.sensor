# Zeek sensor: writes JSON logs to the volume the NDR service ingests.
FROM zeek/zeek:9.0.1

COPY deploy/zeek-entrypoint.sh /usr/local/bin/zeek-entrypoint.sh
RUN chmod +x /usr/local/bin/zeek-entrypoint.sh

ENV SENSOR_INTERFACE=eth0 \
    NDR_ZEEK_LOG_DIR=/var/log/zeek

VOLUME ["/var/log/zeek"]
ENTRYPOINT ["/usr/local/bin/zeek-entrypoint.sh"]
