# syntax=docker/dockerfile:1

# ---- dashboard build -------------------------------------------------------
FROM node:22-slim AS dashboard
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- API + dashboard runtime ----------------------------------------------
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY models/ ./models/
COPY reports/ ./reports/
COPY params.yaml ./
COPY --from=dashboard /frontend/dist ./frontend/dist

ENV NDR_FRONTEND_DIST=/app/frontend/dist \
    NDR_ZEEK_LOG_DIR=/var/log/zeek \
    NDR_DB_PATH=/app/data/realtime/ndr.db \
    NDR_INGEST_ENABLED=true

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request; port=os.environ.get('PORT','8000'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/api/health', timeout=3).status == 200 else 1)"]

# PaaS platforms (Render, Fly, Cloud Run) inject PORT and terminate TLS in front of
# the container, so honour PORT and trust the proxy headers for scheme/host.
CMD ["sh", "-c", "exec uvicorn src.api.app:app --host 0.0.0.0 --port \"${PORT:-8000}\" --proxy-headers --forwarded-allow-ips=\"*\""]
